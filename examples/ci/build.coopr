from "docker.io/library/golang:1.27@sha256:e519d3b0a5b285e5aa53ab9eef02bc6bbb9cb04608389b743a136a9ce75f0d1e" as="builder" {
    workdir "/workspace"
    env CGO_ENABLED="0" GOTOOLCHAIN="local" GOMAXPROCS="1" GOMEMLIMIT="768MiB" GOFLAGS="-p=1"
    copy "go.mod" "go.sum" "/workspace/"
    copy "cmd" "/workspace/cmd"
    copy "internal" "/workspace/internal"
    run "go build -mod=readonly -trimpath -o /stoke ./cmd/stoke"
}

from "scratch" as="binary" {
    copy "/stoke" "/stoke" from="builder"
}
